generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  tagline     String
  description String
  image       String
  skuBase     String
  channel     String    @default("retail") // retail | wholesale | inquiry
  featured    Boolean   @default(false)
  visible     Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  variants    Variant[]
}

model Variant {
  id              String          @id @default(cuid())
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  size            String
  sku             String          @unique
  retailPrice     Int? // pesewas
  wholesalePrice  Int? // pesewas
  avgCostPesewas  Int             @default(0)
  stock           Int             @default(0) // denormalized on-hand cache
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  movements       StockMovement[]
  purchaseLines   PurchaseLine[]
  saleLines       SaleLine[]
  orderItems      OrderItem[]

  @@index([productId])
}

model Order {
  id              String      @id @default(cuid())
  reference       String      @unique
  status          String      @default("pending") // pending | pending_cod | paid | fulfilled | cancelled
  paymentMethod   String // paystack | cod | whatsapp
  customerName    String
  customerEmail   String
  customerPhone   String
  addressLine1    String?
  city            String?
  region          String?
  notes           String?
  subtotal        Int
  shipping        Int
  total           Int
  paystackRef     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productSlug String
  productName String
  size        String
  quantity    Int
  unitPrice   Int
  lineTotal   Int

  @@index([orderId])
  @@index([variantId])
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  role         String          @default("owner") // owner | manager | till
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  movements    StockMovement[]
  purchases    Purchase[]
  sessions     TillSession[]
  sales        Sale[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]

  @@index([name])
}

model StockMovement {
  id              String   @id @default(cuid())
  variantId       String
  variant         Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type            String // opening | received | sold | adjusted | damaged | returned
  qty             Int // signed: + in, - out
  unitCostPesewas Int?
  refType         String? // order | sale | purchase | adjust
  refId           String?
  note            String?
  createdById     String?
  createdBy       User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([variantId])
  @@index([createdAt])
  @@index([refType, refId])
}

model Purchase {
  id           String         @id @default(cuid())
  supplier     String
  notes        String?
  freightPesewas Int          @default(0)
  status       String         @default("draft") // draft | received
  receivedAt   DateTime?
  createdById  String?
  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lines        PurchaseLine[]
}

model PurchaseLine {
  id              String   @id @default(cuid())
  purchaseId      String
  purchase        Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variantId       String
  variant         Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  qty             Int
  unitCostPesewas Int
  lineTotal       Int

  @@index([purchaseId])
  @@index([variantId])
}

model TillSession {
  id           String    @id @default(cuid())
  status       String    @default("open") // open | closed
  floatCash    Int       @default(0)
  countedCash  Int?
  expectedCash Int?
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  openedById   String?
  openedBy     User?     @relation(fields: [openedById], references: [id], onDelete: SetNull)
  sales        Sale[]

  @@index([status])
}

model Sale {
  id              String     @id @default(cuid())
  sessionId       String
  session         TillSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  receiptNumber   String     @unique
  status          String     @default("completed") // completed | returned | voided
  paymentMethod   String // momo | cash | bank | split
  momoRef         String? // optional MoMo or bank transfer reference
  cashPesewas     Int        @default(0)
  momoPesewas     Int        @default(0)
  bankPesewas     Int        @default(0)
  customerId      String?
  customer        Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName    String?
  customerPhone   String?
  subtotal        Int
  total           Int
  tendered        Int?
  changeGiven     Int?
  oversellNote    String?
  returnNote      String?
  returnedAt      DateTime?
  idempotencyKey  String     @unique
  servedById      String?
  servedBy        User?      @relation(fields: [servedById], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  lines           SaleLine[]

  @@index([sessionId])
  @@index([createdAt])
  @@index([customerId])
  @@index([status])
}

model SaleLine {
  id              String  @id @default(cuid())
  saleId          String
  sale            Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variantId       String
  variant         Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productName     String
  size            String
  sku             String
  quantity        Int
  unitPrice       Int
  lineTotal       Int
  costStamped     Int     @default(0)
  returnedQty     Int     @default(0)

  @@index([saleId])
  @@index([variantId])
}

model ReceiptCounter {
  id      String @id @default("default")
  year    Int
  lastSeq Int    @default(0)
}

model Setting {
  key   String @id
  value String
}

/// Ops network — retailers, suppliers, agents, distributors, importers
model Partner {
  id                   String    @id @default(cuid())
  sourceKey            String    @unique
  kind                 String // retailer | supplier | sales_agent | distributor | importer
  name                 String
  location             String?
  phone                String?
  email                String?
  status               String    @default("active") // active | inactive | needs_verification
  verificationStatus   String    @default("unverified") // unverified | verified | disputed
  relationshipMonths   Int?
  relationshipStartedAt DateTime?
  notes                String?
  sourceDate           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  offerings            SupplierOffering[]
  account              RetailerAccount?
  ledgerEntries        RetailerLedgerEntry[]

  @@index([kind])
  @@index([status])
}

model SupplierOffering {
  id         String   @id @default(cuid())
  partnerId  String
  partner    Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  category   String // produce | packaging | material | service
  itemName   String
  unit       String?
  notes      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([partnerId])
}

model RetailerAccount {
  id            String   @id @default(cuid())
  partnerId     String   @unique
  partner       Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  creditLimitPesewas Int @default(0)
  paymentTermsDays Int   @default(0)
  status        String   @default("open")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RetailerLedgerEntry {
  id              String   @id @default(cuid())
  partnerId       String
  partner         Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type            String // charge | payment | credit_note | adjustment
  amountPesewas   Int
  dueDate         DateTime?
  reference       String?
  idempotencyKey  String   @unique
  note            String?
  createdAt       DateTime @default(now())

  @@index([partnerId])
  @@index([createdAt])
}

model ProductionBatch {
  id           String   @id @default(cuid())
  batchCode    String   @unique
  status       String   @default("planned") // planned | running | qa_hold | released | cancelled
  plannedAt    DateTime?
  startedAt    DateTime?
  releasedAt   DateTime?
  yieldNotes   String?
  wasteNotes   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  inputs       BatchInput[]
  outputs      BatchOutput[]
  checks       QualityCheck[]
}

model BatchInput {
  id          String          @id @default(cuid())
  batchId     String
  batch       ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  itemName    String
  lot         String?
  quantity    Float
  unit        String
  costPesewas Int             @default(0)
  supplierName String?

  @@index([batchId])
}

model BatchOutput {
  id           String          @id @default(cuid())
  batchId      String
  batch        ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  variantId    String?
  productName  String
  size         String
  plannedQty   Int             @default(0)
  actualQty    Int             @default(0)
  unitCostPesewas Int          @default(0)

  @@index([batchId])
}

model QualityCheck {
  id          String          @id @default(cuid())
  batchId     String
  batch       ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  checkpoint  String
  result      String // pass | fail | hold
  measuredValue String?
  notes       String?
  checkedAt   DateTime        @default(now())

  @@index([batchId])
}

model EquipmentAsset {
  id           String    @id @default(cuid())
  name         String
  capacity     String?
  status       String    @default("in_use") // in_use | needs_repair | planned | retired
  targetDate   DateTime?
  acquiredDate DateTime?
  costPesewas  Int?
  notes        String?
  sourceDate   DateTime?
  verificationStatus String @default("baseline")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ComplianceItem {
  id           String    @id @default(cuid())
  kind         String // sop | fda | certification | registration
  title        String
  authority    String?
  status       String    @default("roadmap") // documented | current | roadmap | expired
  issuedAt     DateTime?
  expiresAt    DateTime?
  targetDate   DateTime?
  evidenceUrl  String?
  ownerNote    String?
  sourceDate   DateTime?
  verificationStatus String @default("unverified")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([kind])
  @@index([status])
}

model TradeInquiry {
  id                 String   @id @default(cuid())
  organization       String
  contactName        String
  email              String
  phone              String?
  targetMarket       String
  productsJson       String   @default("[]")
  volumeBand         String
  privateLabel       Boolean  @default(false)
  certificationNeeds String?
  notes              String?
  consent            Boolean  @default(false)
  status             String   @default("new") // new | reviewing | replied | closed
  ownerNotes         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model BusinessBaseline {
  id                 String   @id @default(cuid())
  sourceKey          String   @unique
  label              String
  valueJson          String
  sourceDate         DateTime
  verificationStatus String   @default("needs_verification")
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  entityType String?
  entityId   String?
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}
